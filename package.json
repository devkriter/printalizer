{
  "name": "printalizer",
  "version": "0.0.0",
  "private": true,
  "description": "Rewrites STL files so they print better: tented holes, counterbore steps, chamfers and more.",
  "license": "AGPL-3.0-or-later",
  "repository": { "type": "git", "url": "https://github.com/devkriter/printalizer.git" },
  "homepage": "https://devkriter.github.io/printalizer/",
  "type": "module",
  "scripts": {
    "dev": "vite --config app/vite.config.ts --port 8793 --strictPort",
    "build": "vite build --config app/vite.config.ts",
    "test": "node --test \"core/**/*.test.ts\" \"features/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "phase0:corpus": "node phase0/fetch-corpus.ts",
    "phase0:run": "node phase0/run.ts",
    "phase0:print": "node phase0/test-print.ts",
    "phase0:3mf": "node phase0/threemf-check.ts",
    "phase0:view": "vite --config phase0/vite.config.ts --port 8792 --strictPort",
    "new-feature": "node tools/new-feature.ts",
    "phase0:showcase": "node phase0/showcase.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "fflate": "0.8.3",
    "manifold-3d": "3.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.17"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
